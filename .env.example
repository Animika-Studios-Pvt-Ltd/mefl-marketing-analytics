# Local PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=MEFL_MARKETING_ANALYTICS
DB_USER=postgres
DB_PASSWORD=your_local_password

# Neon Cloud Serverless PostgreSQL Configuration
NEON_DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_DB_HOST=ep-your-endpoint.ap-southeast-1.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_NAME=neondb
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=your_neon_password

# Target Database Mode: "BOTH", "NEON", or "LOCAL"
TARGET_DB=BOTH
